VUE_APP_DEV_API_TARGET=http://127.0.0.1:18001
# Optional alternatives:
# VUE_APP_DEV_API_HOST=127.0.0.1
# BACKEND_PORT=18001
# For LAN development, leave VUE_APP_API_BASE and VUE_APP_WS_BASE unset so
# the browser follows the frontend URL, for example 192.168.2.112:18581.
# If explicit bases are required, use the frontend machine's LAN IP:
# VUE_APP_API_BASE=http://<LAN_IP>:18581
# VUE_APP_WS_BASE=ws://<LAN_IP>:18581
